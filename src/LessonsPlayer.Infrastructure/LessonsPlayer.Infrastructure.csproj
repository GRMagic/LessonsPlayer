<Project Sdk="Microsoft.NET.Sdk">
  <!-- Implementações concretas: NAudio, Whisper.net, HTTP e arquivos. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LessonsPlayer.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="Whisper.net" />
    <!-- Runtimes nativos: Vulkan (qualquer GPU com driver) com fallback para CPU. -->
    <PackageReference Include="Whisper.net.Runtime" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LessonsPlayer.Core\LessonsPlayer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Detector de voz (Silero VAD, licença MIT): tem 0,9 MB e vai junto com o app, na pasta vad\. -->
    <None Update="Whisper\Vad\ggml-silero-v6.2.0.bin" Link="vad\ggml-silero-v6.2.0.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Whisper\Vad\LICENSE-silero-vad.txt" Link="vad\LICENSE-silero-vad.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LessonsPlayer.Integration.Tests" />
  </ItemGroup>
</Project>
