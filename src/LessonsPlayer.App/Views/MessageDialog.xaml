<Window x:Class="LessonsPlayer.App.Views.MessageDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" Background="{StaticResource PanelBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
      <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right" />
    </Border>
    <Grid Margin="20,20,24,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="28" Margin="0,0,16,0"
                 VerticalAlignment="Top" />
      <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" FontSize="14"
                 VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
    </Grid>
  </DockPanel>
</Window>
