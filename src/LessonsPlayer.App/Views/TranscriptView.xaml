<UserControl x:Class="LessonsPlayer.App.Views.TranscriptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LessonsPlayer.Presentation.ViewModels;assembly=LessonsPlayer.Presentation"
             xmlns:res="clr-namespace:LessonsPlayer.Presentation.Resources;assembly=LessonsPlayer.Presentation"
             xmlns:behaviors="clr-namespace:LessonsPlayer.App.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TranscriptViewModel}"
             d:DesignWidth="700" d:DesignHeight="400">
  <DockPanel Background="{StaticResource PanelBrush}">

    <!-- Cabeçalho: seguir áudio, desfazer/refazer e salvar -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <ToggleButton Style="{StaticResource FlatButton}" IsChecked="{Binding FollowAudio}"
                      Content="{x:Static res:UiText.FollowAudio}" />
        <Button Style="{StaticResource FlatButton}" Command="{Binding UndoCommand}" ToolTip="{x:Static res:UiText.Undo}"
                AutomationProperties.Name="{x:Static res:UiText.Undo}">
          <TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphUndo}" />
        </Button>
        <Button Style="{StaticResource FlatButton}" Command="{Binding RedoCommand}" ToolTip="{x:Static res:UiText.Redo}"
                AutomationProperties.Name="{x:Static res:UiText.Redo}">
          <TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphRedo}" />
        </Button>
        <Button Style="{StaticResource FlatButton}" Command="{Binding SaveCommand}" ToolTip="Ctrl+S">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphSave}" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{x:Static res:UiText.Save}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <Grid>
      <!-- Lista virtualizada de trechos; cada trecho é um WrapPanel de palavras clicáveis. -->
      <ListBox x:Name="SegmentList"
               ItemsSource="{Binding Segments}"
               Focusable="False"
               BorderThickness="0"
               Background="Transparent"
               Padding="8"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling"
               VirtualizingPanel.ScrollUnit="Pixel">
        <ListBox.ItemContainerStyle>
          <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                  <Border x:Name="Root" CornerRadius="8" Padding="10,6" Margin="0,1" Background="Transparent">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                      <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    </DataTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>

        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:SegmentViewModel}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <TextBlock Text="{Binding StartText}" Style="{StaticResource Muted}" FontSize="12"
                         VerticalAlignment="Top" Margin="0,6,0,0" />

              <ItemsControl Grid.Column="1" ItemsSource="{Binding Words}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:WordViewModel}">
                    <Grid>
                      <!-- Tag leva o TranscriptViewModel para o ContextMenu (que fica fora da árvore visual). -->
                      <Border x:Name="Chip"
                              CornerRadius="4" Padding="3,1" Margin="0,1,2,1"
                              Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                              Cursor="Hand" ToolTip="{Binding Tooltip}"
                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}">
                        <Border.InputBindings>
                          <MouseBinding Gesture="LeftClick"
                                        Command="{Binding DataContext.ClickWordCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                        CommandParameter="{Binding}" />
                          <MouseBinding Gesture="LeftDoubleClick"
                                        Command="{Binding DataContext.BeginEditWordCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                        CommandParameter="{Binding}" />
                          <MouseBinding Gesture="RightClick"
                                        Command="{Binding DataContext.SelectWordCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                        CommandParameter="{Binding}" />
                        </Border.InputBindings>
                        <Border.ContextMenu>
                          <!-- O clique direito seleciona a palavra; os comandos agem sobre a palavra selecionada. -->
                          <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{x:Static res:UiText.EditWord}" Command="{Binding BeginEditWordCommand}" />
                            <MenuItem Header="{x:Static res:UiText.EditSegment}" Command="{Binding EditSegmentCommand}" />
                            <Separator />
                            <MenuItem Header="{x:Static res:UiText.AdjustTiming}">
                              <MenuItem Header="{x:Static res:UiText.SetStartHere}" Command="{Binding SetStartHereCommand}" />
                              <MenuItem Header="{x:Static res:UiText.SetEndHere}" Command="{Binding SetEndHereCommand}" />
                              <Separator />
                              <MenuItem Header="{x:Static res:UiText.NudgeStartEarlier}" Command="{Binding NudgeStartEarlierCommand}" />
                              <MenuItem Header="{x:Static res:UiText.NudgeStartLater}" Command="{Binding NudgeStartLaterCommand}" />
                              <MenuItem Header="{x:Static res:UiText.NudgeEndEarlier}" Command="{Binding NudgeEndEarlierCommand}" />
                              <MenuItem Header="{x:Static res:UiText.NudgeEndLater}" Command="{Binding NudgeEndLaterCommand}" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{x:Static res:UiText.SplitHere}" Command="{Binding SplitHereCommand}" />
                            <MenuItem Header="{x:Static res:UiText.MergeWithPrevious}" Command="{Binding MergeWithPreviousCommand}" />
                            <MenuItem Header="{x:Static res:UiText.MergeWithNext}" Command="{Binding MergeWithNextCommand}" />
                            <Separator />
                            <MenuItem Header="{x:Static res:UiText.DeleteWord}" Command="{Binding DeleteWordCommand}" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <TextBlock x:Name="WordText" Text="{Binding Text}" FontSize="17" />
                      </Border>

                      <!-- Edição inline (Enter confirma, Esc cancela, perder o foco confirma). -->
                      <TextBox x:Name="Editor"
                               Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                               Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                               FontSize="17" MinWidth="60" Padding="2,0" Margin="0,1,2,1"
                               behaviors:InlineEdit.CommitCommand="{Binding DataContext.CommitEditWordCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}">
                        <TextBox.InputBindings>
                          <KeyBinding Key="Enter"
                                      Command="{Binding DataContext.CommitEditWordCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                      CommandParameter="{Binding}" />
                          <KeyBinding Key="Escape"
                                      Command="{Binding DataContext.CancelEditWordCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                      CommandParameter="{Binding}" />
                        </TextBox.InputBindings>
                      </TextBox>
                    </Grid>

                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WordState.Spoken}">
                        <Setter TargetName="WordText" Property="Foreground" Value="{StaticResource SpokenWordBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WordState.Current}">
                        <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentBrush}" />
                        <Setter TargetName="WordText" Property="Foreground" Value="White" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource SelectionBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsEditing}" Value="True">
                        <Setter TargetName="Chip" Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Estado vazio -->
      <TextBlock Text="{Binding EmptyMessage}" TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                 HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15">
        <TextBlock.Style>
          <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Muted}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding EmptyMessage}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
  </DockPanel>
</UserControl>
