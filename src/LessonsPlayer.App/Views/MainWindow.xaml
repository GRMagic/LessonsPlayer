<Window x:Class="LessonsPlayer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LessonsPlayer.Presentation.ViewModels;assembly=LessonsPlayer.Presentation"
        xmlns:res="clr-namespace:LessonsPlayer.Presentation.Resources;assembly=LessonsPlayer.Presentation"
        xmlns:views="clr-namespace:LessonsPlayer.App.Views"
        xmlns:behaviors="clr-namespace:LessonsPlayer.App.Behaviors"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}"
        Width="1120" Height="720" MinWidth="920" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True">
  <DockPanel Background="{StaticResource WindowBrush}">

    <!-- ===== Barra de ferramentas ===== -->
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button Style="{StaticResource FlatButton}" Command="{Binding OpenFolderCommand}"
                  AutomationProperties.Name="{x:Static res:UiText.OpenFolder}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphFolder}" />
              <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{x:Static res:UiText.OpenFolder}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource FlatButton}" Command="{Binding OpenFileCommand}"
                  AutomationProperties.Name="{x:Static res:UiText.OpenFile}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphFile}" />
              <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{x:Static res:UiText.OpenFile}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Geração de legenda -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" DataContext="{Binding Transcription}">
          <!-- Sem rótulos ao lado: a barra precisa caber na largura mínima da janela (nome e dica explicam). -->
          <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" Width="270"
                    ToolTip="{x:Static res:UiText.Model}" AutomationProperties.Name="{x:Static res:UiText.Model}"
                    IsEnabled="{Binding IsIdle}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ModelOption}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Margin="8,0,0,0" Style="{StaticResource Muted}" Text="{Binding SizeText}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <ComboBox Margin="8,0,0,0" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                    DisplayMemberPath="Name" Width="170" IsEnabled="{Binding CanChooseLanguage}"
                    AutomationProperties.Name="{x:Static res:UiText.Language}"
                    ToolTipService.ShowOnDisabled="True">
            <ComboBox.Style>
              <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="ToolTip" Value="{x:Static res:UiText.Language}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedModel.Model.EnglishOnly}" Value="True">
                    <Setter Property="ToolTip" Value="{x:Static res:UiText.EnglishOnlyModelHint}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ComboBox.Style>
          </ComboBox>

          <!-- Sem opção de GPU: ela é usada sempre que houver, e a barra de status diz se a legenda sai na GPU ou na CPU. -->
          <Button Style="{StaticResource AccentButton}" Margin="10,0,0,0" Command="{Binding GenerateCommand}"
                  AutomationProperties.Name="{x:Static res:UiText.GenerateSubtitle}"
                  Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Foreground="White" Text="{StaticResource GlyphSubtitle}" />
              <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{x:Static res:UiText.GenerateSubtitle}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource FlatButton}" Margin="10,0,0,0" Command="{Binding GenerateCancelCommand}"
                  AutomationProperties.Name="{x:Static res:UiText.Cancel}"
                  Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphCancel}" />
              <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{x:Static res:UiText.Cancel}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Barra de status ===== -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,3">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Right" Width="180" Height="6" Minimum="0" Maximum="1"
                     Value="{Binding Transcription.Progress, Mode=OneWay}"
                     IsIndeterminate="{Binding Transcription.IsProgressIndeterminate}"
                     Visibility="{Binding Transcription.IsRunning, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock DockPanel.Dock="Right" Margin="0,0,10,0" Style="{StaticResource Muted}"
                   Text="{Binding Transcription.StatusText}" />
        <TextBlock Style="{StaticResource Muted}" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- ===== Player ===== -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,8">
      <Grid DataContext="{Binding Player}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource FlatButton}" ToolTip="{x:Static res:UiText.PreviousHint}"
                  AutomationProperties.Name="{x:Static res:UiText.PreviousHint}"
                  Command="{Binding DataContext.PreviousTrackCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphPrevious}" />
          </Button>
          <Button Style="{StaticResource FlatButton}" Command="{Binding PlayPauseCommand}"
                  ToolTip="{x:Static res:UiText.PlayPauseHint}" Padding="12,6"
                  AutomationProperties.Name="{x:Static res:UiText.PlayPauseHint}">
            <TextBlock FontSize="22">
              <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Icon}">
                  <Setter Property="Text" Value="{StaticResource GlyphPlay}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                      <Setter Property="Text" Value="{StaticResource GlyphPause}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Button>
          <Button Style="{StaticResource FlatButton}" ToolTip="{x:Static res:UiText.NextHint}"
                  AutomationProperties.Name="{x:Static res:UiText.NextHint}"
                  Command="{Binding DataContext.NextTrackCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphNext}" />
          </Button>
          <ToggleButton Style="{StaticResource FlatButton}" Margin="4,0,0,0" IsChecked="{Binding AutoAdvance}"
                        Content="{x:Static res:UiText.AutoAdvance}" ToolTip="{x:Static res:UiText.AutoAdvanceHint}"
                        AutomationProperties.HelpText="{x:Static res:UiText.AutoAdvanceHint}" />
        </StackPanel>

        <TextBlock Grid.Column="1" Width="60" TextAlignment="Right" VerticalAlignment="Center"
                   Text="{Binding PositionText}" />
        <Slider Grid.Column="2" Margin="12,0" AutomationProperties.Name="{x:Static res:UiText.PositionHint}" VerticalAlignment="Center" Focusable="False"
                Minimum="0" Maximum="{Binding SliderMaximum}"
                Value="{Binding PositionSeconds, Mode=TwoWay}"
                IsMoveToPointEnabled="True" IsEnabled="{Binding HasMedia}"
                behaviors:SliderScrub.IsScrubbing="{Binding IsScrubbing, Mode=TwoWay}" />
        <TextBlock Grid.Column="3" Width="60" VerticalAlignment="Center" Style="{StaticResource Muted}"
                   Text="{Binding DurationText}" />

        <StackPanel Grid.Column="4" Orientation="Horizontal" ToolTip="{x:Static res:UiText.VolumeHint}">
          <TextBlock Style="{StaticResource Icon}" Foreground="{StaticResource MutedTextBrush}" Text="{StaticResource GlyphVolume}" />
          <Slider Width="100" Margin="8,0,0,0" VerticalAlignment="Center" Focusable="False"
                  AutomationProperties.Name="{x:Static res:UiText.VolumeHint}"
                  Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" IsMoveToPointEnabled="True"
                  Value="{Binding Volume}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Conteúdo: playlist + legenda ===== -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270" MinWidth="160" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="14,10,12,6" FontWeight="SemiBold"
                     Text="{Binding Playlist.FolderName}" TextTrimming="CharacterEllipsis" />

          <!-- Busca: nomes das aulas e texto das legendas (Ctrl+F leva o foco para cá; Esc limpa). -->
          <Grid DockPanel.Dock="Top" Margin="10,0,10,8" DataContext="{Binding Search}">
            <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4,28,4" VerticalContentAlignment="Center"
                     ToolTip="{x:Static res:UiText.SearchHint}"
                     AutomationProperties.Name="{x:Static res:UiText.SearchPlaceholder}"
                     AutomationProperties.HelpText="{x:Static res:UiText.SearchHint}">
              <TextBox.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding ClearCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Margin="9,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Text="{x:Static res:UiText.SearchPlaceholder}" TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Muted}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasQuery}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Right" Margin="0,0,2,0" Padding="6,3"
                    Command="{Binding ClearCommand}" ToolTip="{x:Static res:UiText.ClearSearch}"
                    AutomationProperties.Name="{x:Static res:UiText.ClearSearch}"
                    Visibility="{Binding HasQuery, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="{StaticResource GlyphCancel}" />
            </Button>
          </Grid>

          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <!-- Os trechos das legendas só ocupam espaço enquanto há busca. -->
              <RowDefinition>
                <RowDefinition.Style>
                  <Style TargetType="{x:Type RowDefinition}">
                    <Setter Property="Height" Value="0" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Search.HasQuery}" Value="True">
                        <Setter Property="Height" Value="1.4*" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </RowDefinition.Style>
              </RowDefinition>
            </Grid.RowDefinitions>

            <ListBox DataContext="{Binding Playlist}" ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding SelectedItem}"
                     BorderThickness="0" Background="Transparent" Padding="4,0"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.Resources>
                <!-- Um menu por item (x:Shared): o DataContext dele é o item. O Tag do item leva o MainViewModel. -->
                <ContextMenu x:Key="PlaylistItemMenu" x:Shared="False">
                  <MenuItem Header="{x:Static res:UiText.DeleteSubtitle}" CommandParameter="{Binding}"
                            Command="{Binding PlacementTarget.Tag.DeleteSubtitleCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                </ContextMenu>
              </ListBox.Resources>
              <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                  <!-- Sem isso, leitores de tela anunciam o nome da classe do ViewModel. -->
                  <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                  <!-- No item (e não no conteúdo), o menu também abre pelo teclado (Shift+F10). -->
                  <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                  <Setter Property="ContextMenu" Value="{StaticResource PlaylistItemMenu}" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.InputBindings>
                <KeyBinding Key="Enter" CommandParameter="{Binding SelectedItem}"
                            Command="{Binding DataContext.PlayItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
              </ListBox.InputBindings>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PlaylistItemViewModel}">
                  <Grid Background="Transparent" Margin="0,3" ToolTip="{Binding FileName}">
                    <Grid.InputBindings>
                      <MouseBinding Gesture="LeftDoubleClick" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.PlayItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    </Grid.InputBindings>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="20" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource AccentBrush}"
                               Text="{StaticResource GlyphPlay}"
                               Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Margin="6,0,4,0" Style="{StaticResource Icon}" FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" Text="{StaticResource GlyphSubtitle}"
                               ToolTip="{x:Static res:UiText.HasSubtitleHint}"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                      <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                      <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource Muted}"
                       Text="{x:Static res:UiText.PlaylistEmpty}"
                       Visibility="{Binding Playlist.IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource Muted}"
                       Text="{x:Static res:UiText.NoLessonNamesMatch}"
                       Visibility="{Binding Playlist.HasNoNameMatches, Converter={StaticResource BoolToVisibility}}" />

            <!-- Trechos das legendas que casam com a busca: o clique abre a aula e vai até o trecho. -->
            <DockPanel Grid.Row="1" DataContext="{Binding Search}"
                       Visibility="{Binding HasQuery, Converter={StaticResource BoolToVisibility}}">
              <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8,12,4">
                <TextBlock FontWeight="SemiBold" Text="{Binding SubtitleMatchesHeader}" TextTrimming="CharacterEllipsis" />
              </Border>
              <ListBox x:Name="SubtitleMatchList" ItemsSource="{Binding SubtitleMatches}"
                       BorderThickness="0" Background="Transparent" Padding="4,0"
                       HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.InputBindings>
                  <KeyBinding Key="Enter" CommandParameter="{Binding SelectedItem, ElementName=SubtitleMatchList}"
                              Command="{Binding DataContext.OpenSubtitleMatchCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                </ListBox.InputBindings>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:SubtitleMatchViewModel}">
                    <StackPanel Background="Transparent" Margin="0,3" Cursor="Hand">
                      <StackPanel.InputBindings>
                        <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                      Command="{Binding DataContext.OpenSubtitleMatchCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                      </StackPanel.InputBindings>
                      <TextBlock Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding LessonTitle, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StartText, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Grid>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Background="Transparent" Focusable="False" />

      <views:TranscriptView Grid.Column="2" DataContext="{Binding Transcript}" />
    </Grid>
  </DockPanel>
</Window>
