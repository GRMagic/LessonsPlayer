<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Paleta -->
  <Color x:Key="AccentColor">#2563EB</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFF4FF" />
  <SolidColorBrush x:Key="WindowBrush" Color="#F6F7F9" />
  <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="BorderBrush" Color="#E3E6EA" />
  <SolidColorBrush x:Key="TextBrush" Color="#1F2328" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />
  <SolidColorBrush x:Key="HoverBrush" Color="#EEF0F3" />
  <SolidColorBrush x:Key="SpokenWordBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#F59E0B" />

  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- Glifos (Segoe Fluent Icons) -->
  <sys:String x:Key="GlyphPlay">&#xE768;</sys:String>
  <sys:String x:Key="GlyphPause">&#xE769;</sys:String>
  <sys:String x:Key="GlyphPrevious">&#xE892;</sys:String>
  <sys:String x:Key="GlyphNext">&#xE893;</sys:String>
  <sys:String x:Key="GlyphVolume">&#xE767;</sys:String>
  <sys:String x:Key="GlyphFolder">&#xED25;</sys:String>
  <sys:String x:Key="GlyphFile">&#xE8E5;</sys:String>
  <sys:String x:Key="GlyphSubtitle">&#xE7F0;</sys:String>
  <sys:String x:Key="GlyphSave">&#xE74E;</sys:String>
  <sys:String x:Key="GlyphUndo">&#xE7A7;</sys:String>
  <sys:String x:Key="GlyphRedo">&#xE7A6;</sys:String>
  <sys:String x:Key="GlyphCancel">&#xE711;</sys:String>
  <sys:String x:Key="GlyphCheck">&#xE73E;</sys:String>

  <Style TargetType="{x:Type Window}">
    <Setter Property="Background" Value="{StaticResource WindowBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Botão plano com ícone e texto opcional. Focusable=False: o Espaço fica para play/pause. -->
  <Style x:Key="FlatButton" TargetType="{x:Type ButtonBase}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ButtonBase}">
          <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Opacity" Value="0.9" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Icon" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Muted" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style TargetType="{x:Type ComboBox}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Padding" Value="6,3" />
  </Style>

  <Style TargetType="{x:Type CheckBox}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
