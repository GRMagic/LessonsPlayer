<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aplicação WPF: Views, serviços de UI e composition root (DI). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LessonsPlayer.App</RootNamespace>
    <AssemblyName>LessonsPlayer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Gerado por tools\make-icon.ps1. Também é o ícone das janelas que não definem um próprio. -->
    <ApplicationIcon>Assets\LessonsPlayer.ico</ApplicationIcon>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Só o inglês do .NET/WPF vai na publicação (a UI do app não usa os recursos localizados deles). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LessonsPlayer.Infrastructure\LessonsPlayer.Infrastructure.csproj" />
    <ProjectReference Include="..\LessonsPlayer.Presentation\LessonsPlayer.Presentation.csproj" />
  </ItemGroup>

  <!-- Publicação enxuta: tira o que o win-x64 não usa (runtimes nativos de Linux/ARM/x86) e os .xml de documentação. -->
  <Target Name="PruneUnusedPublishFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_UnusedPublishFile Include="@(ResolvedFileToPublish)"
                          Condition="('%(ResolvedFileToPublish.Extension)' == '.xml') Or ($([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes')) And !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Contains('win-x64')))" />
      <ResolvedFileToPublish Remove="@(_UnusedPublishFile)" />
    </ItemGroup>
  </Target>
</Project>
