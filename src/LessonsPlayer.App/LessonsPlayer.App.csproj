<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aplicação WPF: Views, serviços de UI e composition root (DI). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LessonsPlayer.App</RootNamespace>
    <AssemblyName>LessonsPlayer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LessonsPlayer.Infrastructure\LessonsPlayer.Infrastructure.csproj" />
    <ProjectReference Include="..\LessonsPlayer.Presentation\LessonsPlayer.Presentation.csproj" />
  </ItemGroup>
</Project>
